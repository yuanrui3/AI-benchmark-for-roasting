# Copy to .env and fill in. Never commit .env.
# Anthropic: Claude generator and judge arms.
ANTHROPIC_API_KEY=
# OpenRouter: GPT, Gemini, Qwen, DeepSeek, Llama arms through one key.
OPENROUTER_API_KEY=

# Park a provider whose key exists but has no credit (comma list: anthropic, openrouter).
# Every arm, judge and fallback on it is then skipped cleanly. Remove it after a top-up.
DISABLED_PROVIDERS=
